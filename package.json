{
  "name": "cakewalk",
  "version": "0.1.0",
  "description": "CakeWalk — walk against the Eid exodus through replica Dhaka streets",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "osm:fetch": "tsx tools/osm/fetch.ts",
    "osm:bake": "tsx tools/osm/bake.ts",
    "cap:sync": "npm run build && cap sync"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fahimSiam/CakeWalk.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/fahimSiam/CakeWalk/issues"
  },
  "homepage": "https://github.com/fahimSiam/CakeWalk#readme",
  "dependencies": {
    "@capacitor/core": "^8.4.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "@types/three": "^0.184.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
